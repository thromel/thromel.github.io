---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.html_pages | sort: "url" %}
  {% for entry in sitemap_pages %}
    {% unless entry.sitemap == false or entry.robots contains "noindex" or entry.url == "/404.html" %}
  <url>
    <loc>{{ entry.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc>
  </url>
    {% endunless %}
  {% endfor %}
  {% assign sitemap_posts = site.posts | sort: "url" %}
  {% for entry in sitemap_posts %}
    {% unless entry.sitemap == false or entry.robots contains "noindex" %}
  <url>
    <loc>{{ entry.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc>
    <lastmod>{{ entry.last_modified_at | default: entry.date | date_to_xmlschema }}</lastmod>
  </url>
    {% endunless %}
  {% endfor %}
  {% assign sitemap_showcase = site.showcase | sort: "url" %}
  {% for entry in sitemap_showcase %}
    {% unless entry.published == false or entry.sitemap == false or entry.robots contains "noindex" %}
  <url>
    <loc>{{ entry.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc>
    {% if entry.date %}<lastmod>{{ entry.last_modified_at | default: entry.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
