<footer class="site-footer" role="contentinfo">
  <div class="container">
    <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span>
    <span class="sep">&middot;</span>
    <span>built with <a href="https://jekyllrb.com/" target="_blank" rel="noopener">jekyll</a> + <a href="https://github.com/alshedivat/al-folio" target="_blank" rel="noopener">al-folio</a></span>
    {% if site.last_updated %}<span class="sep">&middot;</span><span>updated {{ 'now' | date: '%Y-%m-%d' }}</span>{% endif %}
  </div>
</footer>
