---
import type { SocialKey } from '@config/site';
import { site } from '@config/site';
import { withBase } from '@utils/base';

import IconArxiv from '~icons/academicons/arxiv';
import IconGoogleScholar from '~icons/academicons/google-scholar';
import IconInspire from '~icons/academicons/inspire';
import IconOrcid from '~icons/academicons/orcid';
import IconResearchgate from '~icons/academicons/researchgate';
import IconGithub from '~icons/fa-brands/github';
import IconGitlab from '~icons/fa-brands/gitlab';
import IconInstagram from '~icons/fa-brands/instagram';
import IconLinkedin from '~icons/fa-brands/linkedin';
import IconMastodon from '~icons/fa-brands/mastodon';
import IconMedium from '~icons/fa-brands/medium';
import IconTwitter from '~icons/fa-brands/twitter';
import IconYoutube from '~icons/fa-brands/youtube';
import IconEnvelope from '~icons/fa-solid/envelope';
import IconFilePdf from '~icons/fa-solid/file-pdf';
import IconRss from '~icons/fa-solid/rss';

interface Props {
  /** Additional CSS classes for the container */
  class?: string;
  /** Icon size in pixels */
  size?: number;
  /** 'icons' renders icon-only links; 'buttons' renders labelled pill buttons. */
  variant?: 'icons' | 'buttons';
  /** Only render these platforms, in this order. Defaults to every configured platform. */
  include?: readonly SocialKey[];
}

const { class: className = '', size = 18, variant = 'icons', include } = Astro.props;
const s = site.socials;

type SocialLink = {
  key: SocialKey;
  href: string;
  label: string;
  Icon: typeof IconGithub;
};

const links: SocialLink[] = [];

if (s.email) {
  links.push({ key: 'email', href: `mailto:${s.email}`, label: 'Email', Icon: IconEnvelope });
}
if (s.x_username) {
  links.push({
    key: 'x_username',
    href: `https://x.com/${s.x_username}`,
    label: 'X (Twitter)',
    Icon: IconTwitter,
  });
}
if (s.linkedin_username) {
  links.push({
    key: 'linkedin_username',
    href: `https://www.linkedin.com/in/${s.linkedin_username}`,
    label: 'LinkedIn',
    Icon: IconLinkedin,
  });
}
if (s.github_username) {
  links.push({
    key: 'github_username',
    href: `https://github.com/${s.github_username}`,
    label: 'GitHub',
    Icon: IconGithub,
  });
}
if (s.gitlab_username) {
  links.push({
    key: 'gitlab_username',
    href: `https://gitlab.com/${s.gitlab_username}`,
    label: 'GitLab',
    Icon: IconGitlab,
  });
}
if (s.scholar_userid) {
  links.push({
    key: 'scholar_userid',
    href: `https://scholar.google.com/citations?user=${s.scholar_userid}`,
    label: 'Google Scholar',
    Icon: IconGoogleScholar,
  });
}
if (s.orcid_id) {
  links.push({
    key: 'orcid_id',
    href: `https://orcid.org/${s.orcid_id}`,
    label: 'ORCID',
    Icon: IconOrcid,
  });
}
if (s.inspire_id) {
  links.push({
    key: 'inspire_id',
    href: `https://inspirehep.net/authors/${s.inspire_id}`,
    label: 'InspireHEP',
    Icon: IconInspire,
  });
}
if (s.researchgate_username) {
  links.push({
    key: 'researchgate_username',
    href: `https://www.researchgate.net/profile/${s.researchgate_username}`,
    label: 'ResearchGate',
    Icon: IconResearchgate,
  });
}
if (s.arxiv_id) {
  links.push({
    key: 'arxiv_id',
    href: `https://arxiv.org/a/${s.arxiv_id}.html`,
    label: 'arXiv',
    Icon: IconArxiv,
  });
}
if (s.youtube_id) {
  links.push({
    key: 'youtube_id',
    href: `https://www.youtube.com/@${s.youtube_id}`,
    label: 'YouTube',
    Icon: IconYoutube,
  });
}
if (s.instagram_username) {
  links.push({
    key: 'instagram_username',
    href: `https://www.instagram.com/${s.instagram_username}`,
    label: 'Instagram',
    Icon: IconInstagram,
  });
}
if (s.mastodon_url) {
  links.push({ key: 'mastodon_url', href: s.mastodon_url, label: 'Mastodon', Icon: IconMastodon });
}
if (s.bluesky_handle) {
  links.push({
    key: 'bluesky_handle',
    href: `https://bsky.app/profile/${s.bluesky_handle}`,
    label: 'Bluesky',
    Icon: IconTwitter,
  });
}
if (s.medium_username) {
  links.push({
    key: 'medium_username',
    href: `https://medium.com/@${s.medium_username}`,
    label: 'Medium',
    Icon: IconMedium,
  });
}
if (s.cv_pdf) {
  links.push({ key: 'cv_pdf', href: withBase(s.cv_pdf), label: 'CV', Icon: IconFilePdf });
}
if (s.rss_icon) {
  links.push({ key: 'rss_icon', href: `${site.base}/rss.xml`, label: 'RSS', Icon: IconRss });
}

const shown = include ? include.flatMap((key) => links.filter((link) => link.key === key)) : links;
const isButtons = variant === 'buttons';
---

<div class={`social-links ${isButtons ? 'social-links--buttons' : ''} ${className}`}>
  {
    shown.map((link) => (
      <a
        href={link.href}
        aria-label={isButtons ? undefined : link.label}
        title={isButtons ? undefined : link.label}
        target={link.href.startsWith('mailto:') ? undefined : '_blank'}
        rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        class="social-link"
      >
        <link.Icon width={size} height={size} aria-hidden="true" />
        {isButtons && <span>{link.label}</span>}
      </a>
    ))
  }
</div>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
    color: var(--global-text-color);
    text-decoration: none;
    border-radius: var(--ui-radius-sm);
    transition:
      color 0.15s,
      background-color 0.15s,
      border-color 0.15s;
  }

  .social-link:hover {
    color: var(--global-theme-color);
  }

  .social-links--buttons .social-link {
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    border-radius: var(--ui-radius);
    border: 1px solid var(--global-divider-color);
    background-color: transparent;
  }

  .social-links--buttons .social-link:first-child {
    color: var(--global-bg-color);
    background-color: var(--global-text-color);
    border-color: var(--global-text-color);
  }

  .social-links--buttons .social-link:hover {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
  }

  .social-links--buttons .social-link:first-child:hover {
    color: var(--global-hover-text-color);
    background-color: var(--global-theme-color);
    border-color: var(--global-theme-color);
  }
</style>
