---
import { renderCVHighlight } from '@utils/cv';

interface Props {
  /** Main title line (job title, degree, paper title). */
  title: string;
  /** Secondary line (institution, company, journal). */
  subtitle?: string;
  /** Location string — shown below date. */
  location?: string;
  /** Date range or single date string (already formatted). */
  dates?: string;
  /** Bullet points. */
  highlights?: string[];
  /** URL to make the title a link. */
  url?: string;
}

const { title, subtitle, location, dates, highlights = [], url } = Astro.props;
---

<li class="cv-entry">
  <div class="cv-entry-rail">
    {dates && <span class="cv-entry-dates">{dates}</span>}
    {location && <span class="cv-entry-location">{location}</span>}
  </div>
  <div class="cv-entry-content">
    <h3 class="cv-entry-title">
      {
        url ? (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    {subtitle && <p class="cv-entry-subtitle">{subtitle}</p>}
    {
      highlights.length > 0 && (
        <ul class="cv-entry-highlights">
          {highlights.map((h) => (
            <li set:html={renderCVHighlight(h)} />
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .cv-entry {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.45rem 1.35rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .cv-entry:first-child {
    padding-top: 0.25rem;
  }

  .cv-entry:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .cv-entry-rail {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.15rem;
  }

  .cv-entry-dates {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--global-text-color-light);
    font-variant-numeric: tabular-nums;
  }

  .cv-entry-location {
    font-size: 0.78rem;
    color: var(--global-text-color-light);
  }

  .cv-entry-content {
    min-width: 0;
  }

  .cv-entry-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--global-text-color);
  }

  .cv-entry-title a {
    color: var(--global-text-color);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--global-theme-color) 40%, transparent);
    text-underline-offset: 0.18em;
  }

  .cv-entry-title a:hover {
    color: var(--global-theme-color);
    text-decoration-color: var(--global-theme-color);
  }

  .cv-entry-subtitle {
    margin: 0.2rem 0 0;
    font-size: 0.92rem;
    color: var(--global-text-color-light);
  }

  .cv-entry-highlights {
    margin: 0.6rem 0 0;
    padding-left: 1.15rem;
    list-style: disc;
    font-size: 0.91rem;
    line-height: 1.62;
    color: var(--global-text-color);
  }

  .cv-entry-highlights li + li {
    margin-top: 0.35rem;
  }

  .cv-entry-highlights :global(a) {
    color: var(--global-theme-color);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.18em;
  }

  .cv-entry-highlights :global(a:hover) {
    color: var(--global-hover-color);
    text-decoration-color: currentColor;
  }

  @media (max-width: 640px) {
    .cv-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .cv-entry-rail {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      padding-top: 0;
    }
  }
</style>
