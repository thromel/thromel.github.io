---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Only render h2 and h3
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
if (tocHeadings.length === 0) return;
---

<nav aria-label="Table of contents" class="toc">
  <p class="toc-heading">Table of Contents</p>
  <ul class="toc-list">
    {
      tocHeadings.map((h) => (
        <li class:list={['toc-item', { 'toc-item--sub': h.depth === 3 }]}>
          <a href={`#${h.slug}`} class="toc-link">
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  let tocObserver: IntersectionObserver | null = null;

  function initToc() {
    tocObserver?.disconnect();
    tocObserver = null;

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    if (links.length === 0) return;

    const headingIds = links
      .map((l) => l.getAttribute('href')?.slice(1) ?? '')
      .filter((id) => id.length > 0);

    function setActive(id: string) {
      links.forEach((l) => {
        const isActive = l.getAttribute('href') === `#${id}`;
        l.classList.toggle('is-active', isActive);
      });
    }

    const navbarHeight =
      parseInt(getComputedStyle(document.documentElement).getPropertyValue('--navbar-height')) ||
      57;

    tocObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: `-${navbarHeight + 8}px 0px -78% 0px`, threshold: 0 },
    );

    headingIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) tocObserver?.observe(el);
    });
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>

<style>
  .toc {
    position: sticky;
    top: 5rem;
    font-size: 0.8125rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }

  .toc-heading {
    margin: 0 0 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--global-divider-color);
  }

  .toc-item {
    margin: 0.15rem 0;
  }

  .toc-item--sub .toc-link {
    padding-left: 1.35rem;
    font-size: 0.78rem;
  }

  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 0.22rem 0 0.22rem 0.75rem;
    border-left: 2px solid transparent;
    color: var(--global-text-color-light);
    text-decoration: none;
    line-height: 1.4;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--global-theme-color);
  }

  .toc-link.is-active {
    color: var(--global-theme-color);
    font-weight: 600;
    border-left-color: var(--global-theme-color);
  }
</style>
