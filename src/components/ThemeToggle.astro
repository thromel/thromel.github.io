---
// ThemeToggle — light ↔ dark toggle.
// Uses data-attributes so both desktop and mobile instances stay in sync.
// Initial state is set by the FOUC inline script in Base.astro (respects OS preference).
---

<button
  data-light-toggle
  class="theme-toggle-btn"
  type="button"
  title="Switch to dark mode"
  aria-label="Switch to dark mode"
  aria-pressed="false"
>
  <!-- Moon icon: shown in light mode (click to go dark) -->
  <span data-light-toggle-icon="moon">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="17"
      height="17"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>

  <!-- Sun icon: shown in dark mode (click to go light) -->
  <span data-light-toggle-icon="sun" style="display: none;">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="17"
      height="17"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </span>
</button>

<style>
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: var(--ui-radius-sm);
    background: transparent;
    color: var(--global-text-color-light);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .theme-toggle-btn:hover {
    color: var(--global-theme-color);
    background-color: var(--global-theme-tint);
  }

  @media (max-width: 767px) {
    .theme-toggle-btn {
      width: 2.5rem;
      height: 2.5rem;
      color: var(--global-text-color);
    }
  }
</style>

<script>
  function syncThemeMeta(theme: string) {
    const themeColor = document.getElementById('theme-color');
    if (themeColor) {
      themeColor.setAttribute('content', theme === 'dark' ? '#111317' : '#faf9f6');
    }
  }

  function updateIcons(theme: string) {
    const isDark = theme === 'dark';
    const nextLabel = isDark ? 'Switch to light mode' : 'Switch to dark mode';

    // Update icons and accessible state on ALL toggle instances (desktop + mobile)
    document.querySelectorAll<HTMLElement>('[data-light-toggle-icon]').forEach((el) => {
      const show =
        (isDark && el.getAttribute('data-light-toggle-icon') === 'sun') ||
        (!isDark && el.getAttribute('data-light-toggle-icon') === 'moon');
      el.style.display = show ? 'inline-block' : 'none';
    });

    document.querySelectorAll<HTMLButtonElement>('[data-light-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isDark));
      btn.setAttribute('aria-label', nextLabel);
      btn.setAttribute('title', nextLabel);
    });
  }

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    syncThemeMeta(theme);
    updateIcons(theme);
  }

  function toggle() {
    // Read the APPLIED theme from the DOM — guarantees every click is visible
    const current = document.documentElement.getAttribute('data-theme') ?? 'light';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  }

  function wire() {
    document.querySelectorAll('[data-light-toggle]').forEach((btn) => {
      btn.removeEventListener('click', toggle);
      btn.addEventListener('click', toggle);
    });
  }

  // Wire buttons and sync icons with the theme already applied by the FOUC script
  const initialTheme = document.documentElement.getAttribute('data-theme') ?? 'light';
  wire();
  syncThemeMeta(initialTheme);
  updateIcons(initialTheme);

  // Re-wire after Astro View Transitions (soft navigation)
  document.addEventListener('astro:after-swap', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') ?? 'light';
    wire();
    syncThemeMeta(currentTheme);
    updateIcons(currentTheme);
  });

  // Follow OS preference changes only when the user has no explicit stored preference
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      const theme = e.matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
      syncThemeMeta(theme);
      updateIcons(theme);
    }
  });
</script>
