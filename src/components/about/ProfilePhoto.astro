---
import { site } from '@config/site';
import { withBase } from '@utils/base';

interface Props {
  src?: string;
  alt?: string;
  /** 'none' renders a block-level photo for grid/flex layouts instead of floating it. */
  align?: 'left' | 'right' | 'none';
  circular?: boolean;
  /** Intrinsic image size, used to reserve space and avoid layout shift. */
  width?: number;
  height?: number;
  /** Render `site.author.moreInfo` under the photo. */
  showMoreInfo?: boolean;
  /** Apply card shadow around the portrait image. */
  elevated?: boolean;
}

const {
  src = site.author.avatar,
  alt = site.author.name,
  align = 'right',
  circular = false,
  width = 800,
  height = 1000,
  showMoreInfo = true,
  elevated = true,
} = Astro.props;

const imgSrc = withBase(src);
const fallback = withBase('/assets/img/prof_pic.jpg');
const shapeClass = circular ? 'rounded-circle' : 'rounded';
const imgClass = elevated ? `img-fluid z-depth-1 ${shapeClass}` : `img-fluid ${shapeClass}`;
const wrapperClass = align === 'none' ? 'profile profile--block' : `profile float-${align}`;
---

<div class={wrapperClass}>
  <img
    src={imgSrc}
    alt={alt}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    width={width}
    height={height}
    class={imgClass}
    onerror={`this.onerror=null;this.src='${fallback}'`}
  />
  {
    showMoreInfo && site.author.moreInfo && (
      <div class="more-info" set:html={site.author.moreInfo} />
    )
  }
</div>
