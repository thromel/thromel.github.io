---
interface Props {
  /** URL of the previous page (undefined if on first page). */
  prevUrl?: string;
  /** URL of the next page (undefined if on last page). */
  nextUrl?: string;
  /** Current page number (1-based). */
  currentPage: number;
  /** Total number of pages. */
  totalPages: number;
  /** Base path for page links, e.g. '/blog/'. Page N links to base + N. */
  basePath: string;
}

const { prevUrl, nextUrl, currentPage, totalPages, basePath } = Astro.props;
if (totalPages <= 1) return;

// Build page number list with ellipsis
function buildPageList(current: number, total: number): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: (number | '...')[] = [1];
  if (current > 3) pages.push('...');
  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) {
    pages.push(i);
  }
  if (current < total - 2) pages.push('...');
  pages.push(total);
  return pages;
}

const pageList = buildPageList(currentPage, totalPages);

function pageUrl(n: number): string {
  return n === 1 ? basePath : `${basePath}page/${n}/`;
}
---

<nav aria-label="Pagination" class="pagination-nav">
  <!-- Previous -->
  {
    prevUrl ? (
      <a href={prevUrl} aria-label="Previous page" class="pagination-btn">
        &laquo;
      </a>
    ) : (
      <span aria-disabled="true" class="pagination-btn pagination-btn--disabled">
        &laquo;
      </span>
    )
  }

  <!-- Page numbers -->
  {
    pageList.map((p) =>
      p === '...' ? (
        <span class="pagination-ellipsis">…</span>
      ) : (
        <a
          href={pageUrl(p as number)}
          aria-label={`Page ${p}`}
          aria-current={p === currentPage ? 'page' : undefined}
          class:list={['pagination-btn', { 'pagination-btn--active': p === currentPage }]}
        >
          {p}
        </a>
      ),
    )
  }

  <!-- Next -->
  {
    nextUrl ? (
      <a href={nextUrl} aria-label="Next page" class="pagination-btn">
        &raquo;
      </a>
    ) : (
      <span aria-disabled="true" class="pagination-btn pagination-btn--disabled">
        &raquo;
      </span>
    )
  }
</nav>

<style>
  .pagination-nav {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .pagination-btn {
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--ui-radius-sm);
    border: 1px solid var(--global-divider-color);
    background-color: var(--global-card-bg-color);
    color: var(--global-text-color);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  a.pagination-btn:hover {
    background-color: var(--global-hover-color);
    border-color: var(--global-hover-color);
    color: var(--global-hover-text-color);
  }

  .pagination-btn--active {
    border-color: var(--global-theme-color);
    background-color: var(--global-theme-color);
    color: var(--global-hover-text-color);
    font-weight: 600;
  }

  .pagination-btn--disabled {
    color: var(--global-text-color-light);
    background-color: transparent;
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pagination-ellipsis {
    padding: 0 0.3rem;
    color: var(--global-text-color-light);
  }
</style>
