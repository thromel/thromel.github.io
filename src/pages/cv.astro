---
import CVEntry from '@components/cv/CVEntry.astro';
import CVSection from '@components/cv/CVSection.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import type { JSONResume, RenderCV, RenderCVEntry } from '@utils/cv';
import { formatCVDate, formatDateRange } from '@utils/cv';
import yaml from 'js-yaml';

import IconFilePdf from '~icons/fa-solid/file-pdf';

import cvRaw from '../data/cv.yml?raw';
import resumeData from '../data/resume.json';

const format = site.cv.format;

const renderCV = format === 'rendercv' ? (yaml.load(cvRaw) as RenderCV) : null;
const jsonResume = format === 'jsonresume' ? (resumeData as JSONResume) : null;

const rc = renderCV?.cv ?? null;
const education = (rc?.sections?.education ?? []) as RenderCVEntry[];
const experience = (rc?.sections?.experience ?? []) as RenderCVEntry[];
const rcPublications = (rc?.sections?.publications ?? []) as RenderCVEntry[];
const awards = (rc?.sections?.awards ?? []) as RenderCVEntry[];
const skills = (rc?.sections?.skills ?? []) as RenderCVEntry[];
const interests = (rc?.sections?.interests ?? []) as RenderCVEntry[];

const jr = jsonResume ?? null;
const jrLabel = jr?.basics?.label ?? '';

const downloadLabel = site.cv.downloadLabel ?? 'Download PDF';

// Build sidebar TOC items based on which sections have data
type TocItem = { label: string; href: string };

const tocItems: TocItem[] = [];
if (format === 'rendercv' && rc) {
  if (rc.name || rc.email || rc.phone) tocItems.push({ label: 'Contact Information', href: '#contact' });
  if (rc.summary) tocItems.push({ label: 'Professional Summary', href: '#summary' });
  if (education.length > 0) tocItems.push({ label: 'Education', href: '#education' });
  if (experience.length > 0) tocItems.push({ label: 'Experience', href: '#experience' });
  if (rcPublications.length > 0) tocItems.push({ label: 'Publications', href: '#publications' });
  if (awards.length > 0) tocItems.push({ label: 'Awards', href: '#awards' });
  if (skills.length > 0) tocItems.push({ label: 'Skills', href: '#skills' });
  if (interests.length > 0) tocItems.push({ label: 'Interests', href: '#interests' });
} else if (format === 'jsonresume' && jr) {
  if (jr.basics) tocItems.push({ label: 'Contact Information', href: '#contact' });
  if (jr.work?.length) tocItems.push({ label: 'Experience', href: '#experience' });
  if (jr.education?.length) tocItems.push({ label: 'Education', href: '#education' });
  if (jr.publications?.length) tocItems.push({ label: 'Publications', href: '#publications' });
  if (jr.awards?.length) tocItems.push({ label: 'Awards', href: '#awards' });
  if (jr.skills?.length) tocItems.push({ label: 'Skills', href: '#skills' });
  if (jr.languages?.length) tocItems.push({ label: 'Languages', href: '#languages' });
  if (jr.interests?.length) tocItems.push({ label: 'Interests', href: '#interests' });
}
---

<Page title="CV" description={`Curriculum vitae of ${site.author.name}`}>
  <div class="post">
    <header class="post-header cv-header">
      <h1 class="post-title">CV</h1>
      {site.cv.pdfPath && (
        <a
          href={withBase(site.cv.pdfPath)}
          target="_blank"
          rel="noopener noreferrer"
          class="cv-download-btn"
          aria-label="Download CV PDF"
        >
          <IconFilePdf width={14} height={14} aria-hidden="true" />
          <span>{downloadLabel}</span>
        </a>
      )}
    </header>

    <article>
      <div class="cv-page-wrapper">
        <!-- Sidebar TOC -->
        {tocItems.length > 0 && (
          <nav class="cv-sidebar-toc" aria-label="CV sections">
            <ul>
              {tocItems.map((item) => (
                <li>
                  <a href={item.href} class="cv-toc-link">{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <!-- CV content -->
        <div class="cv">

          <!-- ── RENDERCV ──────────────────────────────────────────────── -->
          {format === 'rendercv' && renderCV && (
            <>
              {rc && (rc.name || rc.email || rc.phone || rc.website || rc.location) && (
                <CVSection title="Contact Information" id="contact">
                  <dl class="cv-contact-grid">
                    {rc.name && (
                      <>
                        <dt>Name</dt>
                        <dd>{rc.name}</dd>
                      </>
                    )}
                    {rc.email && (
                      <>
                        <dt>Email</dt>
                        <dd><a href={`mailto:${rc.email}`}>{rc.email}</a></dd>
                      </>
                    )}
                    {rc.phone && (
                      <>
                        <dt>Phone</dt>
                        <dd>{rc.phone}</dd>
                      </>
                    )}
                    {rc.location && (
                      <>
                        <dt>Location</dt>
                        <dd>{rc.location}</dd>
                      </>
                    )}
                    {rc.website && (
                      <>
                        <dt>Website</dt>
                        <dd>
                          <a href={rc.website} target="_blank" rel="noopener noreferrer">{rc.website}</a>
                        </dd>
                      </>
                    )}
                  </dl>
                </CVSection>
              )}

              {rc?.summary && (
                <CVSection title="Professional Summary" id="summary">
                  <p class="cv-summary-text">{rc.summary}</p>
                </CVSection>
              )}

              {education.length > 0 && (
                <CVSection title="Education" id="education">
                  <ul class="cv-entry-list">
                    {education.map((e) => (
                      <CVEntry
                        title={[e.degree, e.area].filter(Boolean).join(' in ')}
                        subtitle={e.institution}
                        location={e.location}
                        dates={formatDateRange(e.start_date, e.end_date)}
                        highlights={e.highlights}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {experience.length > 0 && (
                <CVSection title="Experience" id="experience">
                  <ul class="cv-entry-list">
                    {experience.map((e) => (
                      <CVEntry
                        title={e.position ?? ''}
                        subtitle={e.company}
                        location={e.location}
                        dates={formatDateRange(e.start_date, e.end_date)}
                        highlights={e.highlights}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {rcPublications.length > 0 && (
                <CVSection title="Selected Publications" id="publications">
                  <ul class="cv-entry-list">
                    {rcPublications.map((e) => (
                      <CVEntry
                        title={e.title ?? ''}
                        subtitle={[e.authors?.join(', '), e.journal].filter(Boolean).join(' — ')}
                        dates={formatCVDate(e.date)}
                        url={e.doi ? `https://doi.org/${e.doi}` : e.url}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {awards.length > 0 && (
                <CVSection title="Honors &amp; Awards" id="awards">
                  <ul class="cv-entry-list">
                    {awards.map((e) => (
                      <CVEntry
                        title={e.name ?? ''}
                        subtitle={e.issuer}
                        dates={formatCVDate(e.date)}
                        highlights={e.highlights}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {skills.length > 0 && (
                <CVSection title="Skills" id="skills">
                  <dl class="cv-skill-grid">
                    {skills.map((e) => (
                      <>
                        <dt>{e.label}</dt>
                        <dd>{e.details}</dd>
                      </>
                    ))}
                  </dl>
                </CVSection>
              )}

              {interests.length > 0 && (
                <CVSection title="Interests" id="interests">
                  <dl class="cv-skill-grid">
                    {interests.map((e) => (
                      <>
                        <dt>{e.label}</dt>
                        <dd>{e.details}</dd>
                      </>
                    ))}
                  </dl>
                </CVSection>
              )}
            </>
          )}

          <!-- ── JSONRESUME ─────────────────────────────────────────────── -->
          {format === 'jsonresume' && jsonResume && (
            <>
              {jr?.basics && (
                <CVSection title="Contact Information" id="contact">
                  <dl class="cv-contact-grid">
                    {jr.basics.name && (
                      <>
                        <dt>Name</dt>
                        <dd>{jr.basics.name}</dd>
                      </>
                    )}
                    {jrLabel && (
                      <>
                        <dt>Title</dt>
                        <dd>{jrLabel}</dd>
                      </>
                    )}
                    {jr.basics.email && (
                      <>
                        <dt>Email</dt>
                        <dd><a href={`mailto:${jr.basics.email}`}>{jr.basics.email}</a></dd>
                      </>
                    )}
                    {jr.basics.phone && (
                      <>
                        <dt>Phone</dt>
                        <dd>{jr.basics.phone}</dd>
                      </>
                    )}
                    {jr.basics.url && (
                      <>
                        <dt>Website</dt>
                        <dd>
                          <a href={jr.basics.url} target="_blank" rel="noopener noreferrer">{jr.basics.url}</a>
                        </dd>
                      </>
                    )}
                  </dl>
                </CVSection>
              )}

              {jr?.work && jr.work.length > 0 && (
                <CVSection title="Experience" id="experience">
                  <ul class="cv-entry-list">
                    {jr.work.map((e) => (
                      <CVEntry
                        title={e.position ?? ''}
                        subtitle={e.name}
                        url={e.url}
                        dates={formatDateRange(e.startDate, e.endDate)}
                        highlights={e.highlights}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {jr?.education && jr.education.length > 0 && (
                <CVSection title="Education" id="education">
                  <ul class="cv-entry-list">
                    {jr.education.map((e) => (
                      <CVEntry
                        title={[e.studyType, e.area].filter(Boolean).join(' in ')}
                        subtitle={e.institution}
                        url={e.url}
                        dates={formatDateRange(e.startDate, e.endDate)}
                        highlights={e.courses}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {jr?.publications && jr.publications.length > 0 && (
                <CVSection title="Selected Publications" id="publications">
                  <ul class="cv-entry-list">
                    {jr.publications.map((e) => (
                      <CVEntry
                        title={e.name ?? ''}
                        subtitle={e.publisher}
                        url={e.url}
                        dates={formatCVDate(e.releaseDate)}
                        highlights={e.summary ? [e.summary] : []}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {jr?.awards && jr.awards.length > 0 && (
                <CVSection title="Honors &amp; Awards" id="awards">
                  <ul class="cv-entry-list">
                    {jr.awards.map((e) => (
                      <CVEntry
                        title={e.title ?? ''}
                        subtitle={e.awarder}
                        dates={formatCVDate(e.date)}
                        highlights={e.summary ? [e.summary] : []}
                      />
                    ))}
                  </ul>
                </CVSection>
              )}

              {jr?.skills && jr.skills.length > 0 && (
                <CVSection title="Skills" id="skills">
                  <dl class="cv-skill-grid">
                    {jr.skills.map((e) => (
                      <>
                        <dt>{e.name}</dt>
                        <dd>{e.keywords?.join(', ')}</dd>
                      </>
                    ))}
                  </dl>
                </CVSection>
              )}

              {jr?.languages && jr.languages.length > 0 && (
                <CVSection title="Languages" id="languages">
                  <dl class="cv-skill-grid">
                    {jr.languages.map((e) => (
                      <>
                        <dt>{e.language}</dt>
                        <dd>{e.fluency}</dd>
                      </>
                    ))}
                  </dl>
                </CVSection>
              )}

              {jr?.interests && jr.interests.length > 0 && (
                <CVSection title="Interests" id="interests">
                  <dl class="cv-skill-grid">
                    {jr.interests.map((e) => (
                      <>
                        <dt>{e.name}</dt>
                        <dd>{e.keywords?.join(', ')}</dd>
                      </>
                    ))}
                  </dl>
                </CVSection>
              )}
            </>
          )}

        </div><!-- /.cv -->
      </div><!-- /.cv-page-wrapper -->
    </article>
  </div>
</Page>

<script>
  let cvTocObserver: IntersectionObserver | null = null;

  function initCvToc() {
    cvTocObserver?.disconnect();
    cvTocObserver = null;

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.cv-toc-link'));
    if (links.length === 0) return;

    const setActive = (id: string) => {
      links.forEach((link) => {
        const active = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('is-active', active);
      });
    };

    const navbarHeight =
      parseInt(getComputedStyle(document.documentElement).getPropertyValue('--navbar-height'), 10) ||
      57;

    cvTocObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const sectionAnchor = entry.target.querySelector<HTMLElement>('a.anchor[id]');
            if (sectionAnchor?.id) {
              setActive(sectionAnchor.id);
              break;
            }
          }
        }
      },
      { rootMargin: `-${navbarHeight + 16}px 0px -70% 0px`, threshold: 0 },
    );

    document.querySelectorAll('.cv-section').forEach((section) => {
      cvTocObserver?.observe(section);
    });
  }

  document.addEventListener('astro:page-load', initCvToc);
</script>

<style>
  /* Header with PDF action pill */
  .cv-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .cv-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.4rem;
    padding: 0.42rem 0.95rem;
    border: 1px solid var(--global-theme-color);
    border-radius: 999px;
    background-color: var(--global-theme-color);
    color: var(--global-hover-text-color);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--ui-shadow-sm);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .cv-download-btn:hover {
    background-color: var(--global-hover-color);
    border-color: var(--global-hover-color);
    color: var(--global-hover-text-color);
  }

  /* Two-column layout: sidebar + content */
  .cv-page-wrapper {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  /* Sticky left sidebar TOC */
  .cv-sidebar-toc {
    flex-shrink: 0;
    width: 184px;
    position: sticky;
    top: calc(var(--navbar-height) + 1.5rem);
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }

  .cv-sidebar-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--global-divider-color);
  }

  .cv-sidebar-toc li a {
    display: block;
    padding: 0.35rem 0 0.35rem 0.85rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 0.82rem;
    color: var(--global-text-color-light);
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
    line-height: 1.35;
  }

  .cv-sidebar-toc li a:hover,
  .cv-sidebar-toc li a.is-active {
    color: var(--global-theme-color);
    border-left-color: var(--global-theme-color);
  }

  .cv-sidebar-toc li a.is-active {
    font-weight: 600;
  }

  /* Main CV content fills remaining space */
  .cv {
    flex: 1;
    min-width: 0;
  }

  .cv-entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cv-summary-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--global-text-color);
  }

  /* Contact & Skills definition grids */
  .cv-contact-grid,
  .cv-skill-grid {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.5rem 1.35rem;
    margin: 0;
    font-size: 0.91rem;
    line-height: 1.55;
  }

  .cv-contact-grid dt,
  .cv-skill-grid dt {
    font-weight: 600;
    color: var(--global-text-color-light);
  }

  .cv-contact-grid dd,
  .cv-skill-grid dd {
    margin: 0;
    color: var(--global-text-color);
    min-width: 0;
  }

  .cv-skill-grid dt,
  .cv-skill-grid dd {
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .cv-skill-grid dt:last-of-type,
  .cv-skill-grid dd:last-of-type {
    border-bottom: 0;
    padding-bottom: 0;
  }

  /* Hide sidebar on small screens */
  @media (max-width: 768px) {
    .cv-page-wrapper {
      flex-direction: column;
    }
    .cv-sidebar-toc {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .cv-contact-grid,
    .cv-skill-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }

    .cv-skill-grid dt {
      border-bottom: 0;
      padding-bottom: 0;
      padding-top: 0.65rem;
    }

    .cv-skill-grid dd {
      padding-top: 0;
      padding-bottom: 0.65rem;
    }
  }
</style>
