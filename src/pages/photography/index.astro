---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';

const { enabled, title, description, empty, photos } = site.photography;
const visiblePhotos = enabled ? photos : [];
---

<Page title={title} description={description} noindex={!visiblePhotos.length}>
  <div class="post" data-pagefind-ignore={visiblePhotos.length ? undefined : 'all'}>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>
    </header>
    {
      visiblePhotos.length ? (
        <div class="gallery">
          {visiblePhotos.map((photo, index) => (
            <figure>
              <a href={`${site.base}${photo.image}`}>
                <img
                  src={`${site.base}${index === 0 ? photo.image : photo.thumbnail}`}
                  width={photo.width}
                  height={photo.height}
                  alt={photo.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
              {photo.caption && <figcaption>{photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      ) : (
        <p>{empty}</p>
      )
    }
  </div>
</Page>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  figure:first-child {
    grid-column: 1 / -1;
  }

  a,
  img {
    display: block;
    border-radius: 0.25rem;
  }

  img {
    width: 100%;
    height: auto;
  }

  a:focus-visible {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 4px;
  }

  figcaption {
    margin-top: 0.45rem;
    color: var(--global-text-color-light);
    font-size: 0.875rem;
  }

  @media (max-width: 36rem) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
