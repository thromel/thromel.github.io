---
import ProjectCard from '@components/projects/ProjectCard.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999),
);

// Collect unique categories preserving first-appearance order
const categories: string[] = [];
const categoryCounts = new Map<string, number>();
for (const p of projects) {
  if (p.data.category) {
    if (!categories.includes(p.data.category)) {
      categories.push(p.data.category);
    }
    categoryCounts.set(p.data.category, (categoryCounts.get(p.data.category) ?? 0) + 1);
  }
}
const hasCategories = categories.length > 0;
---

<Page title="Projects" description={`Projects by ${site.author.name}`}>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">Projects</h1>
      <p class="post-description">{site.pages.projects.description}</p>
      {
        categories.length > 1 && (
          <nav class="category-pills" aria-label="Project categories">
            {categories.map((cat) => (
              <a href={`#${cat}`} class="category-pill">
                <span class="category-pill-name">{cat}</span>
                <span class="category-pill-count">{categoryCounts.get(cat)}</span>
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <article>
      <div class="projects">
        {
          projects.length === 0 ? (
            <p style="color: var(--global-text-color-light);">No projects yet.</p>
          ) : hasCategories ? (
            categories.map((cat) => {
              const catProjects = projects.filter((p) => p.data.category === cat);
              return (
                <section aria-labelledby={`cat-${cat}`}>
                  <a id={cat} href={`#${cat}`} class="category-heading-link">
                    <h2 id={`cat-${cat}`} class="category">
                      {cat}
                    </h2>
                  </a>
                  <div class="projects-grid">
                    {catProjects.map((project) => (
                      <ProjectCard project={project} />
                    ))}
                  </div>
                </section>
              );
            })
          ) : (
            <div class="projects-grid">
              {projects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          )
        }
      </div>
    </article>
  </div>
</Page>

<script>
  function initCards() {
    // Make cards clickable while allowing inner links to work independently
    document.querySelectorAll<HTMLElement>('.card[data-href]').forEach((card) => {
      card.style.cursor = 'pointer';

      card.addEventListener('click', (e) => {
        // If user clicked an <a> inside, let the browser handle it
        if ((e.target as HTMLElement).closest('a')) return;
        const href = card.dataset.href;
        if (!href) return;
        if (card.dataset.external === 'true') {
          window.open(href, '_blank', 'noopener,noreferrer');
        } else {
          window.location.href = href;
        }
      });

      // Keyboard accessibility
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });
  }

  // Fetch GitHub star counts from the API
  async function loadGithubStars() {
    const spans = document.querySelectorAll<HTMLElement>('[data-github-stars]');
    await Promise.all(
      [...spans].map(async (span) => {
        const repo = span.dataset.githubStars;
        if (!repo) return;
        try {
          const res = await fetch(`https://api.github.com/repos/${repo}`, {
            headers: { Accept: 'application/vnd.github.v3+json' },
          });
          if (!res.ok) return;
          const data = (await res.json()) as { stargazers_count?: number };
          if (typeof data.stargazers_count === 'number') {
            span.textContent = data.stargazers_count.toLocaleString();
          }
        } catch {
          // Silently ignore — stars are decorative
        }
      }),
    );
  }

  document.addEventListener('astro:page-load', () => {
    initCards();
    loadGithubStars();
  });
</script>

<style>
  /* ── Category jump pills ───────────────────────────────────────────────── */
  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--global-divider-color);
    border-radius: var(--ui-radius-pill);
    background: var(--global-card-bg-color);
    color: var(--global-text-color);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    text-transform: capitalize;
    box-shadow: var(--ui-shadow-sm);
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .category-pill:hover {
    border-color: var(--global-theme-color);
    color: var(--global-theme-color);
    background: var(--global-theme-tint);
  }

  .category-pill-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--global-text-color-light);
  }

  /* ── Projects container ─────────────────────────────────────────────────── */
  .projects a {
    text-decoration: none;
  }

  .category-heading-link {
    display: block;
    text-decoration: none;
  }

  h2.category {
    color: var(--global-text-color);
    border-bottom: 1px solid var(--global-divider-color);
    padding-bottom: 0.45rem;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-transform: capitalize;
    transition: color 0.15s ease;
  }

  .projects section:first-child h2.category {
    margin-top: 0.25rem;
  }

  .category-heading-link:hover h2.category {
    color: var(--global-theme-color);
  }

  /* ── Responsive grid ─────────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17.5rem, 1fr));
    gap: 1.25rem;
  }
</style>
