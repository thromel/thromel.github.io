---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection, render } from 'astro:content';

const announcements = (await getCollection('announcements'))
  .filter((e) => !e.data.hidden)
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const rendered = await Promise.all(
  announcements.map(async (item) => ({ item, rendered: await render(item) })),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Page title="News" description={`News and announcements from ${site.author.name}`}>
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">News</h1>
    </header>
    <article>
      {
        rendered.length === 0 ? (
          <p class="news-empty">No announcements yet.</p>
        ) : (
          <ul class="dated-list">
            {rendered.map(({ item, rendered: { Content } }) => (
              <li>
                <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
                <div class="dated-body news-body">
                  {item.data.type && <span class="news-tag">{item.data.type}</span>}
                  <Content />
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </article>
  </div>
</Page>

<style>
  .news-empty {
    color: var(--global-text-color-light);
  }

  .dated-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dated-list li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .dated-list li:last-child {
    border-bottom: 0;
  }

  .dated-list time {
    font-family: var(--font-mono);
    color: var(--global-text-color-light);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.22rem;
    white-space: nowrap;
  }

  .dated-body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--global-text-color);
  }

  .news-body :global(p) {
    display: inline;
    margin: 0;
  }

  .news-body :global(p + p) {
    margin-left: 0.35rem;
  }

  .news-body :global(p + p a)::after {
    content: ' \2197';
    font-size: 0.8em;
  }

  @media (max-width: 540px) {
    .dated-list li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .dated-list time {
      padding-top: 0;
    }
  }
</style>
