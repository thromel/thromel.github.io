---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', (p) => !p.data.hidden && !p.data.draft);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<Page title="Tags" description={`All post tags on ${site.author.name}'s blog`}>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm">
    <a href={`${site.base}/blog/`} class="archive-back-link">&larr; Back to blog</a>
  </nav>

  <div class="post">
    <header class="post-header">
      <h1 class="post-title">Tags</h1>
    </header>
    {
      tags.length === 0 ? (
        <p style="color: var(--global-text-color-light);">No tags yet.</p>
      ) : (
        <div class="tag-cloud" role="list">
          {tags.map(([tag, count]) => (
            <a
              role="listitem"
              href={`${site.base}/blog/tag/${tag}/`}
              class="tag-item"
              title={`${count} post${count !== 1 ? 's' : ''}`}
            >
              <span class="tag-name">{tag}</span>
              <span class="tag-count">{count}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Page>

<style>
  .archive-back-link {
    color: var(--global-theme-color);
    text-decoration: none;
  }

  .archive-back-link:hover {
    color: var(--global-hover-color);
    text-decoration: underline;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0.5rem 0 1.5rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    background-color: var(--global-card-bg-color);
    color: var(--global-text-color);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .tag-item:hover {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
    background-color: var(--global-theme-tint);
  }

  .tag-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    padding: 0.08rem 0.42rem;
    border-radius: 999px;
    background-color: var(--global-code-bg-color);
    color: var(--global-text-color-light);
  }

  .tag-item:hover .tag-count {
    color: var(--global-theme-color);
  }
</style>
