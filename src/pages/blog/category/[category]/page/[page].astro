---
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { site } from '@config/site';
import PageLayout from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const perPage = site.blog.postsPerPage;
  const postCategories = allPosts.flatMap((p) => p.data.categories);
  const allCategories = [...new Set([...postCategories, ...site.blog.displayCategories])];

  return allCategories.flatMap((category) => {
    const catPosts = allPosts
      .filter((p) => !p.data.hidden && !p.data.draft && p.data.categories.includes(category))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = Math.ceil(catPosts.length / perPage);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
      const page = i + 2;
      return {
        params: { category, page: String(page) },
        props: {
          posts: catPosts.slice((page - 1) * perPage, page * perPage),
          currentPage: page,
          totalPages,
        },
      };
    });
  });
}

const { category } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<PageLayout
  title={`Category: ${category} — Page ${currentPage}`}
  description={`Posts in category "${category}", page ${currentPage}`}
>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm">
    <a href={`${base}/blog/`} class="archive-back-link">&larr; All posts</a>
  </nav>

  <header class="post-header">
    <h1 class="post-title archive-title">
      Category:
      <span class="archive-pill archive-pill--category">{category}</span>
    </h1>
    <p class="post-description">Page {currentPage} of {totalPages}</p>
  </header>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
  </ul>

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={currentPage === 2
      ? `${base}/blog/category/${category}/`
      : `${base}/blog/category/${category}/page/${currentPage - 1}/`}
    nextUrl={currentPage < totalPages
      ? `${base}/blog/category/${category}/page/${currentPage + 1}/`
      : undefined}
    basePath={`${base}/blog/category/${category}/`}
  />
</PageLayout>

<style>
  .archive-back-link {
    color: var(--global-theme-color);
    text-decoration: none;
  }

  .archive-back-link:hover {
    color: var(--global-hover-color);
    text-decoration: underline;
  }

  .archive-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .archive-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.8rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .archive-pill--category {
    background-color: var(--global-code-bg-color);
    color: var(--global-text-color-light);
    border: 1px solid var(--global-divider-color);
  }
</style>
