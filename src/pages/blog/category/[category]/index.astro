---
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const perPage = site.blog.postsPerPage;
  const postCategories = allPosts.flatMap((p) => p.data.categories);
  const allCategories = [...new Set([...postCategories, ...site.blog.displayCategories])];

  return allCategories.map((category) => {
    const catPosts = allPosts
      .filter((p) => !p.data.hidden && !p.data.draft && p.data.categories.includes(category))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = Math.max(1, Math.ceil(catPosts.length / perPage));
    return {
      params: { category },
      props: {
        posts: catPosts.slice(0, perPage),
        currentPage: 1,
        totalPages,
      },
    };
  });
}

const { category } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<Page title={`Category: ${category}`} description={`Posts in category "${category}"`}>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm">
    <a href={`${base}/blog/`} class="archive-back-link">&larr; All posts</a>
  </nav>

  <header class="post-header">
    <h1 class="post-title archive-title">
      Category:
      <span class="archive-pill archive-pill--category">{category}</span>
    </h1>
  </header>

  {
    posts.length === 0 ? (
      <p style="color: var(--global-text-color-light);">No posts found for this category.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )
  }

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={undefined}
    nextUrl={totalPages > 1 ? `${base}/blog/category/${category}/page/2/` : undefined}
    basePath={`${base}/blog/category/${category}/`}
  />
</Page>

<style>
  .archive-back-link {
    color: var(--global-theme-color);
    text-decoration: none;
  }

  .archive-back-link:hover {
    color: var(--global-hover-color);
    text-decoration: underline;
  }

  .archive-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .archive-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.8rem;
    border-radius: var(--ui-radius-pill);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .archive-pill--category {
    background-color: var(--global-code-bg-color);
    color: var(--global-text-color-light);
    border: 1px solid var(--global-divider-color);
  }
</style>
