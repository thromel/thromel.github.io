---
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const perPage = site.blog.postsPerPage;
  const postTags = allPosts.flatMap((p) => p.data.tags);
  const allTags = [...new Set([...postTags, ...site.blog.displayTags])];

  return allTags.map((tag) => {
    const tagPosts = allPosts
      .filter((p) => !p.data.hidden && !p.data.draft && p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = Math.max(1, Math.ceil(tagPosts.length / perPage));
    return {
      params: { tag },
      props: {
        posts: tagPosts.slice(0, perPage),
        currentPage: 1,
        totalPages,
      },
    };
  });
}

const { tag } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<Page title={`Tag: ${tag}`} description={`Posts tagged "${tag}"`}>
  <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-3 text-sm">
    <a href={`${base}/blog/`} class="archive-back-link">&larr; All posts</a>
    <span style="color: var(--global-divider-color);" aria-hidden="true">&middot;</span>
    <a href={`${base}/blog/tags/`} class="archive-back-link">Tag cloud</a>
  </nav>

  <header class="post-header">
    <h1 class="post-title archive-title">
      Posts tagged
      <span class="archive-pill archive-pill--tag">{tag}</span>
    </h1>
  </header>

  {
    posts.length === 0 ? (
      <p style="color: var(--global-text-color-light);">No posts found for this tag.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )
  }

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={undefined}
    nextUrl={totalPages > 1 ? `${base}/blog/tag/${tag}/page/2/` : undefined}
    basePath={`${base}/blog/tag/${tag}/`}
  />
</Page>

<style>
  .archive-back-link {
    color: var(--global-theme-color);
    text-decoration: none;
  }

  .archive-back-link:hover {
    color: var(--global-hover-color);
    text-decoration: underline;
  }

  .archive-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .archive-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.8rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .archive-pill--tag {
    background-color: var(--global-theme-tint);
    color: var(--global-theme-color);
    border: 1px solid color-mix(in srgb, var(--global-theme-color) 28%, transparent);
  }
</style>
