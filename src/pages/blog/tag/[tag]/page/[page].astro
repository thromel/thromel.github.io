---
import PostCard from '@components/blog/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { site } from '@config/site';
import PageLayout from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const perPage = site.blog.postsPerPage;
  const postTags = allPosts.flatMap((p) => p.data.tags);
  const allTags = [...new Set([...postTags, ...site.blog.displayTags])];

  return allTags.flatMap((tag) => {
    const tagPosts = allPosts
      .filter((p) => !p.data.hidden && !p.data.draft && p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = Math.ceil(tagPosts.length / perPage);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
      const page = i + 2;
      return {
        params: { tag, page: String(page) },
        props: {
          posts: tagPosts.slice((page - 1) * perPage, page * perPage),
          currentPage: page,
          totalPages,
        },
      };
    });
  });
}

const { tag } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<PageLayout
  title={`Tag: ${tag} — Page ${currentPage}`}
  description={`Posts tagged "${tag}", page ${currentPage}`}
>
  <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-3 text-sm">
    <a href={`${base}/blog/`} class="archive-back-link">&larr; All posts</a>
    <span style="color: var(--global-divider-color);" aria-hidden="true">&middot;</span>
    <a href={`${base}/blog/tags/`} class="archive-back-link">Tag cloud</a>
  </nav>

  <header class="post-header">
    <h1 class="post-title archive-title">
      Posts tagged
      <span class="archive-pill archive-pill--tag">{tag}</span>
    </h1>
    <p class="post-description">Page {currentPage} of {totalPages}</p>
  </header>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
  </ul>

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={currentPage === 2
      ? `${base}/blog/tag/${tag}/`
      : `${base}/blog/tag/${tag}/page/${currentPage - 1}/`}
    nextUrl={currentPage < totalPages
      ? `${base}/blog/tag/${tag}/page/${currentPage + 1}/`
      : undefined}
    basePath={`${base}/blog/tag/${tag}/`}
  />
</PageLayout>

<style>
  .archive-back-link {
    color: var(--global-theme-color);
    text-decoration: none;
  }

  .archive-back-link:hover {
    color: var(--global-hover-color);
    text-decoration: underline;
  }

  .archive-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .archive-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.8rem;
    border-radius: var(--ui-radius-pill);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .archive-pill--tag {
    background-color: var(--global-theme-tint);
    color: var(--global-theme-color);
    border: 1px solid color-mix(in srgb, var(--global-theme-color) 28%, transparent);
  }
</style>
