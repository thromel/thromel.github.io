---
import ProfilePhoto from '@components/about/ProfilePhoto.astro';
import SocialLinks from '@components/SocialLinks.astro';
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { linkAuthors } from '@utils/authors';
import { withBase } from '@utils/base';
import { getAuthors, getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import AboutContent from '../data/about.mdx';
import bibRaw from '../data/papers.bib?raw';

// Announcements
const allAnnouncements = site.announcements.enabled
  ? (await getCollection('announcements'))
      .filter((e) => !e.data.hidden)
      .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.getTime() - a.data.date.getTime();
      })
      .slice(0, site.announcements.limit)
  : [];

// Latest posts
const allPosts = site.latestPosts.enabled
  ? (await getCollection('posts'))
      .filter((p) => !p.data.hidden)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, site.latestPosts.limit)
  : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

// Selected publications
const selectedPapers = site.selectedPapers.enabled
  ? parseBibtex(bibRaw).filter((e) => getBoolField(e, 'selected'))
  : [];
const authorLastName = site.publications.authorLastName ?? site.author.name.split(' ').pop() ?? '';

// Pre-render announcement content
const renderedAnnouncements = await Promise.all(
  allAnnouncements.map(async (item) => ({ item, rendered: await render(item) })),
);

// Selected work
const allProjects = site.selectedWork.enabled ? await getCollection('projects') : [];
const selectedWork = site.selectedWork.projects
  .map((id) => allProjects.find((proj) => proj.id === id))
  .filter((proj) => proj !== undefined);
const pdfDir = withBase(site.publications.pdfDir);

const heroName = (site.title as string) === 'blank' ? site.author.name : site.title;
---

<Base isHome={true}>
  <div class="page-container home">
    <section class="hero" aria-labelledby="hero-name">
      <div class="hero-text">
        <h1 id="hero-name" class="hero-name">{heroName}</h1>
        {site.hero.lead && <p class="hero-lead" set:html={site.hero.lead} />}
        <div class="hero-affil">
          {site.author.subtitle && <p set:html={site.author.subtitle} />}
          {site.author.moreInfo && <div class="hero-meta" set:html={site.author.moreInfo} />}
        </div>
        <SocialLinks
          variant="buttons"
          include={site.hero.primaryLinks}
          size={14}
          class="hero-links"
        />
      </div>
      <div class="hero-photo">
        <ProfilePhoto align="none" showMoreInfo={false} elevated={false} />
      </div>
    </section>

    {
      site.hero.currently.length > 0 && (
        <section class="home-row" aria-labelledby="home-currently">
          <h2 id="home-currently" class="row-label">
            Currently
          </h2>
          <ol class="currently-list">
            {site.hero.currently.map((item) => (
              <li set:html={item} />
            ))}
          </ol>
        </section>
      )
    }

    <section class="home-row" aria-labelledby="home-about">
      <h2 id="home-about" class="row-label">About</h2>
      <div class="about-prose prose max-w-none">
        <AboutContent />
      </div>
    </section>

    {
      site.announcements.enabled && allAnnouncements.length > 0 && (
        <section class="home-row" aria-labelledby="home-news">
          <div class="row-label">
            <h2 id="home-news">{site.announcements.title}</h2>
            <a href={`${site.base}/news/`} class="row-more">
              {site.viewAllLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class:list={['dated-list', { 'scrollable-list': site.announcements.scrollable }]}>
            {renderedAnnouncements.map(({ item, rendered: { Content } }) => (
              <li>
                <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
                <div class="dated-body news-body">
                  {item.data.type && <span class="news-kind">{item.data.type}</span>}
                  <Content />
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      site.selectedPapers.enabled && selectedPapers.length > 0 && (
        <section class="home-row" aria-labelledby="home-papers">
          <div class="row-label">
            <h2 id="home-papers">{site.selectedPapers.title}</h2>
            <a href={`${site.base}/publications/`} class="row-more">
              {site.viewAllLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ol class="paper-list">
            {selectedPapers.map((entry) => {
              const authors = linkAuthors(getAuthors(entry).split(', '), {}, authorLastName);
              const venue = getVenue(entry);
              const year = getYear(entry);
              const { abbr, note, award, tldr, arxiv, pdf } = entry.fields;
              const pdfHref = pdf && (pdf.startsWith('http') ? pdf : `${pdfDir}${pdf}`);
              return (
                <li class="paper-item">
                  <p class="paper-kicker">
                    {abbr && <span class="paper-venue-abbr">{abbr}</span>}
                    {year > 0 && <span>{year}</span>}
                    {award && <span class="paper-award">{entry.fields.award_name ?? 'Award'}</span>}
                  </p>
                  <a href={`${site.base}/publications/${entry.key}/`} class="paper-title">
                    {getTitle(entry)}
                  </a>
                  <p class="paper-authors">
                    {authors.map((a, i) => (
                      <>
                        {a.isSelf ? <strong>{a.name}</strong> : a.name}
                        {i < authors.length - 1 && ', '}
                      </>
                    ))}
                  </p>
                  {(venue || note) && <p class="paper-venue">{venue || note}</p>}
                  {tldr && <p class="paper-tldr">{tldr}</p>}
                  <p class="paper-links">
                    {arxiv && (
                      <a
                        href={`https://arxiv.org/abs/${arxiv}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        arXiv
                      </a>
                    )}
                    {pdfHref && (
                      <a href={pdfHref} target="_blank" rel="noopener noreferrer">
                        PDF
                      </a>
                    )}
                    <a href={`${site.base}/publications/${entry.key}/`}>Details</a>
                  </p>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }

    {
      site.selectedWork.enabled && selectedWork.length > 0 && (
        <section class="home-row" aria-labelledby="home-work">
          <div class="row-label">
            <h2 id="home-work">{site.selectedWork.title}</h2>
            <a href={`${site.base}/projects/`} class="row-more">
              {site.viewAllLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class="work-list">
            {selectedWork.map((proj) => (
              <li class="work-item">
                <a href={`${site.base}/projects/${proj.id}/`} class="work-title">
                  {proj.data.title}
                </a>
                {proj.data.description && <p class="work-desc">{proj.data.description}</p>}
                {proj.data.github && (
                  <a
                    href={`https://github.com/${proj.data.github}`}
                    class="work-repo"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {proj.data.github}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      site.latestPosts.enabled && allPosts.length > 0 && (
        <section class="home-row" aria-labelledby="home-posts">
          <div class="row-label">
            <h2 id="home-posts">{site.latestPosts.title}</h2>
            <a href={`${site.base}/blog/`} class="row-more">
              {site.viewAllLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ul class:list={['dated-list', { 'scrollable-list': site.latestPosts.scrollable }]}>
            {allPosts.map((post) => (
              <li>
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                <div class="dated-body">
                  <a href={`${site.base}/blog/${post.id}/`} class="post-link">
                    {post.data.title}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .home {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  /* ── Hero: the research statement is the headline ─────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    grid-template-areas:
      'name photo'
      'lead photo'
      'affil photo'
      'links links';
    column-gap: var(--space-12);
    align-items: start;
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--global-rule-strong);
  }

  .hero-name {
    margin: 0 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--global-theme-color);
  }

  .hero-lead {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--global-text-color);
    text-wrap: balance;
  }

  .hero-lead :global(em) {
    color: var(--global-theme-color);
  }

  .hero-affil {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--global-text-color-light);
  }

  .hero-affil :global(p) {
    margin: 0;
  }

  .hero-affil > :global(p:first-child) {
    color: var(--global-text-color);
  }

  .hero-meta :global(p) {
    display: inline;
  }

  .hero-meta :global(p + p)::before {
    content: '·';
    margin: 0 0.5rem;
  }

  /* Flatten .hero-text so its children sit directly on the hero grid. */
  .hero-text {
    display: contents;
  }

  .hero-name {
    grid-area: name;
  }

  .hero-lead {
    grid-area: lead;
  }

  .hero-affil {
    grid-area: affil;
  }

  .hero :global(.hero-links) {
    grid-area: links;
    margin-top: var(--space-6);
  }

  .hero-photo {
    grid-area: photo;
    align-self: center;
    overflow: hidden;
    border-radius: var(--ui-radius-sm);
  }

  .hero-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0 !important;
  }

  :global(html[data-theme='dark']) .hero-photo :global(img) {
    filter: brightness(0.88);
  }

  /* ── Editorial rows: margin label | content ───────────────────────── */
  .home-row {
    display: grid;
    grid-template-columns: var(--margin-col) minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .home-row:last-child {
    border-bottom: 0;
  }

  .row-label,
  .row-label h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--global-theme-color);
  }

  .row-label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .row-more {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--global-text-color-light);
  }

  .row-more:hover {
    color: var(--global-theme-color);
  }

  /* Currently: numbered margin notes */
  .currently-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: now;
    display: grid;
    gap: var(--space-3);
    max-width: 64ch;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .currently-list li {
    counter-increment: now;
    position: relative;
    padding-left: 1.75rem;
  }

  .currently-list li::before {
    content: counter(now, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--global-text-color-light);
  }

  /* About prose */
  .about-prose {
    max-width: 64ch;
    font-size: var(--text-md);
    line-height: 1.7;
  }

  .about-prose :global(p:first-child) {
    margin-top: 0;
  }

  .about-prose :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
    font-size: var(--text-lg);
  }

  /* ── Dated lists (news, writing) ──────────────────────────────────── */
  .dated-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dated-list li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) 0;
  }

  .dated-list li + li {
    border-top: 1px solid var(--global-divider-color);
  }

  .dated-list li:first-child {
    padding-top: 0.2rem;
  }

  .dated-list time {
    padding-top: 0.15rem;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--global-text-color-light);
    white-space: nowrap;
  }

  .dated-body {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .news-kind {
    margin-right: 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--global-theme-color);
  }

  .news-body :global(p) {
    display: inline;
    margin: 0;
  }

  .news-body :global(p + p) {
    margin-left: 0.35rem;
  }

  .news-body :global(p + p a)::after {
    content: ' \2197';
    font-size: 0.8em;
  }

  .post-link {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    color: var(--global-text-color);
  }

  .post-link:hover {
    color: var(--global-theme-color);
  }

  /* ── Selected publications ────────────────────────────────────────── */
  .paper-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .paper-item + .paper-item {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--global-divider-color);
  }

  .paper-kicker {
    display: flex;
    gap: var(--space-3);
    margin: 0 0 var(--space-1);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }

  .paper-venue-abbr {
    color: var(--global-theme-color);
  }

  .paper-award {
    color: var(--global-award-bg);
  }

  .paper-title {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--global-text-color);
    text-wrap: balance;
  }

  .paper-title:hover {
    color: var(--global-theme-color);
  }

  .paper-authors,
  .paper-venue {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--global-text-color-light);
  }

  .paper-authors strong {
    color: var(--global-text-color);
    font-weight: 600;
  }

  .paper-venue {
    margin-top: 0.1rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
  }

  .paper-tldr {
    max-width: 64ch;
    margin: var(--space-3) 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .paper-links a {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 3px;
  }

  /* ── Selected work ────────────────────────────────────────────────── */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-8);
  }

  .work-item {
    display: flex;
    flex-direction: column;
    padding-top: var(--space-3);
    border-top: 2px solid var(--global-rule-strong);
  }

  .work-title {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: 1.3;
    color: var(--global-text-color);
  }

  .work-title:hover {
    color: var(--global-theme-color);
  }

  .work-desc {
    flex: 1;
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--global-text-color-light);
  }

  .work-repo {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 760px) {
    .home {
      padding-top: var(--space-8);
    }

    .hero {
      grid-template-columns: minmax(0, 1fr) 5.5rem;
      grid-template-areas:
        'name photo'
        'lead lead'
        'affil affil'
        'links links';
      gap: var(--space-6);
    }

    .hero-name {
      align-self: center;
      margin: 0;
    }

    .hero-photo {
      border-radius: 50%;
    }

    .hero-photo :global(img) {
      aspect-ratio: 1 / 1;
      object-position: 50% 25%;
    }

    .hero-affil,
    .hero :global(.hero-links) {
      margin-top: 0;
    }

    .home-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .row-label {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }
  }

  @media (max-width: 540px) {
    .dated-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
</style>
