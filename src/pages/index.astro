---
import ProfilePhoto from '@components/about/ProfilePhoto.astro';
import SocialLinks from '@components/SocialLinks.astro';
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { linkAuthors } from '@utils/authors';
import { withBase } from '@utils/base';
import { getAuthors, getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import AboutContent from '../data/about.mdx';
import bibRaw from '../data/papers.bib?raw';

// Announcements
const allAnnouncements = site.announcements.enabled
  ? (await getCollection('announcements'))
      .filter((e) => !e.data.hidden)
      .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.getTime() - a.data.date.getTime();
      })
      .slice(0, site.announcements.limit)
  : [];

// Latest posts
const allPosts = site.latestPosts.enabled
  ? (await getCollection('posts'))
      .filter((p) => !p.data.hidden)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, site.latestPosts.limit)
  : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

// Selected publications
const selectedPapers = site.selectedPapers.enabled
  ? parseBibtex(bibRaw).filter((e) => getBoolField(e, 'selected'))
  : [];
const authorLastName = site.publications.authorLastName ?? site.author.name.split(' ').pop() ?? '';

// Pre-render announcement content
const renderedAnnouncements = await Promise.all(
  allAnnouncements.map(async (item) => ({ item, rendered: await render(item) })),
);

// Selected work
const allProjects = site.selectedWork.enabled ? await getCollection('projects') : [];
const selectedWork = site.selectedWork.projects
  .map((id) => allProjects.find((proj) => proj.id === id))
  .filter((proj) => proj !== undefined);
const pdfDir = withBase(site.publications.pdfDir);

const heroName = (site.title as string) === 'blank' ? site.author.name : site.title;
---

<Base isHome={true}>
  <div class="page-container home py-8">
    <section class="hero" aria-labelledby="hero-name">
      <div class="hero-photo">
        <ProfilePhoto align="none" showMoreInfo={false} elevated={false} />
      </div>

      <header class="hero-intro">
        <h1 id="hero-name" class="hero-name">{heroName}</h1>
        {site.author.subtitle && <p class="hero-subtitle" set:html={site.author.subtitle} />}
        {site.author.moreInfo && <div class="hero-meta" set:html={site.author.moreInfo} />}
      </header>

      <div class="hero-actions">
        <SocialLinks
          variant="buttons"
          include={site.hero.primaryLinks}
          size={15}
          class="hero-links"
        />
      </div>

      {
        site.hero.currently.length > 0 && (
          <div class="hero-currently">
            <p class="hero-currently-label">Currently</p>
            <ul>
              {site.hero.currently.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
          </div>
        )
      }

      <div class="hero-bio prose max-w-none">
        <AboutContent />
      </div>
    </section>

    {
      site.announcements.enabled && allAnnouncements.length > 0 && (
        <section class="home-section" aria-labelledby="home-news">
          <div class="section-head">
            <h2 id="home-news">{site.announcements.title}</h2>
            <a href={`${site.base}/news/`} class="section-more">
              {site.viewAllLabel}
              <span class="section-arrow" aria-hidden="true">
                {' '}
                &rarr;
              </span>
            </a>
          </div>
          <ul class:list={['dated-list', { 'scrollable-list': site.announcements.scrollable }]}>
            {renderedAnnouncements.map(({ item, rendered: { Content } }) => (
              <li>
                <time datetime={isoDate(item.data.date)}>{formatDate(item.data.date)}</time>
                <div class="dated-body news-body">
                  {item.data.type && <span class="news-tag">{item.data.type}</span>}
                  <Content />
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      site.latestPosts.enabled && allPosts.length > 0 && (
        <section class="home-section" aria-labelledby="home-posts">
          <div class="section-head">
            <h2 id="home-posts">{site.latestPosts.title}</h2>
            <a href={`${site.base}/blog/`} class="section-more">
              {site.viewAllLabel}
              <span class="section-arrow" aria-hidden="true">
                {' '}
                &rarr;
              </span>
            </a>
          </div>
          <ul class:list={['dated-list', { 'scrollable-list': site.latestPosts.scrollable }]}>
            {allPosts.map((post) => (
              <li>
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                <div class="dated-body">
                  <a href={`${site.base}/blog/${post.id}/`} class="post-link">
                    {post.data.title}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      site.selectedPapers.enabled && selectedPapers.length > 0 && (
        <section class="home-section" aria-labelledby="home-papers">
          <div class="section-head">
            <h2 id="home-papers">{site.selectedPapers.title}</h2>
            <a href={`${site.base}/publications/`} class="section-more">
              {site.viewAllLabel}
              <span class="section-arrow" aria-hidden="true">
                {' '}
                &rarr;
              </span>
            </a>
          </div>
          <ol class="paper-list">
            {selectedPapers.map((entry) => {
              const authors = linkAuthors(getAuthors(entry).split(', '), {}, authorLastName);
              const venue = getVenue(entry);
              const year = getYear(entry);
              const { abbr, note, award, tldr, arxiv, pdf } = entry.fields;
              const pdfHref = pdf && (pdf.startsWith('http') ? pdf : `${pdfDir}${pdf}`);
              return (
                <li class="paper-item">
                  <div class="paper-tags">
                    {abbr && <span class="badge-abbr">{abbr}</span>}
                    {year > 0 && <span class="paper-year">{year}</span>}
                    {award && (
                      <span class="badge-abbr badge-award">{entry.fields.award_name ?? '🏆'}</span>
                    )}
                  </div>
                  <a href={`${site.base}/publications/${entry.key}/`} class="paper-title">
                    {getTitle(entry)}
                  </a>
                  <p class="paper-authors">
                    {authors.map((a, i) => (
                      <>
                        {a.isSelf ? <strong>{a.name}</strong> : a.name}
                        {i < authors.length - 1 && ', '}
                      </>
                    ))}
                  </p>
                  {(venue || note) && <p class="paper-venue">{venue || note}</p>}
                  {tldr && <p class="paper-tldr">{tldr}</p>}
                  <p class="paper-links">
                    {arxiv && (
                      <a
                        href={`https://arxiv.org/abs/${arxiv}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        arXiv
                      </a>
                    )}
                    {pdfHref && (
                      <a href={pdfHref} target="_blank" rel="noopener noreferrer">
                        PDF
                      </a>
                    )}
                    <a href={`${site.base}/publications/${entry.key}/`}>Details</a>
                  </p>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }

    {
      site.selectedWork.enabled && selectedWork.length > 0 && (
        <section class="home-section" aria-labelledby="home-work">
          <div class="section-head">
            <h2 id="home-work">{site.selectedWork.title}</h2>
            <a href={`${site.base}/projects/`} class="section-more">
              {site.viewAllLabel}
              <span class="section-arrow" aria-hidden="true">
                {' '}
                &rarr;
              </span>
            </a>
          </div>
          <ul class="work-list">
            {selectedWork.map((proj) => (
              <li class="work-item">
                <a href={`${site.base}/projects/${proj.id}/`} class="work-title">
                  {proj.data.title}
                </a>
                {proj.data.description && <p class="work-desc">{proj.data.description}</p>}
                {proj.data.github && (
                  <a
                    href={`https://github.com/${proj.data.github}`}
                    class="work-repo"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {proj.data.github}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
    grid-template-areas:
      'intro photo'
      'links photo'
      'currently currently'
      'bio bio';
    column-gap: 2.75rem;
    row-gap: 1.25rem;
    align-items: start;
  }

  .hero-photo {
    grid-area: photo;
    padding-top: 0.35rem;
  }

  .hero-photo :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--ui-radius) !important;
    border: 1px solid var(--global-divider-color);
    box-shadow: 0 14px 32px -18px rgba(24, 24, 27, 0.3);
  }

  :global(html[data-theme='dark']) .hero-photo :global(img) {
    box-shadow: 0 14px 32px -16px rgba(0, 0, 0, 0.65);
  }

  .hero-intro {
    grid-area: intro;
    min-width: 0;
    margin-bottom: 0;
  }

  .hero-actions {
    grid-area: links;
    min-width: 0;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 4.2vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem;
    color: var(--global-text-color);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--global-text-color);
    margin: 0 0 0.25rem;
  }

  .hero-currently {
    grid-area: currently;
    max-width: 68ch;
    margin: 0.35rem 0 0;
    padding: 0.95rem 1.15rem;
    border-radius: var(--ui-radius-sm);
    background: var(--global-theme-tint);
    border-left: 3px solid var(--global-theme-color);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--global-text-color);
  }

  .hero-currently-label {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
  }

  .hero-currently ul {
    margin: 0;
    padding-left: 1.15rem;
    list-style: disc;
  }

  .hero-currently li + li {
    margin-top: 0.35rem;
  }

  .hero-meta {
    color: var(--global-text-color-light);
    font-size: 0.9375rem;
    margin-bottom: 0;
  }

  .hero-meta :global(p) {
    display: inline;
    margin: 0;
  }

  .hero-meta :global(p + p)::before {
    content: '·';
    margin: 0 0.5rem;
  }

  .hero-bio {
    grid-area: bio;
    max-width: 68ch;
    margin-top: 0.5rem;
  }

  .hero-bio :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.4rem;
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 5.5rem;
      grid-template-areas:
        'intro photo'
        'links links'
        'currently currently'
        'bio bio';
      column-gap: 1rem;
      row-gap: 1.15rem;
    }

    .hero-photo {
      width: 5.5rem;
      padding-top: 0.2rem;
      margin-bottom: 0;
    }

    .hero-meta :global(p) {
      display: block;
    }

    .hero-meta :global(p + p)::before {
      content: none;
    }
  }

  @media (max-width: 359px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'photo'
        'intro'
        'links'
        'currently'
        'bio';
    }

    .hero-photo {
      width: 5.75rem;
    }
  }

  /* ── Sections ──────────────────────────────────────────────────────── */
  .home-section {
    margin-top: 3.5rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.55rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .section-head h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--global-text-color);
  }

  .section-more {
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .section-more .section-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .section-more:hover .section-arrow {
    transform: translateX(2px);
  }

  /* ── Dated lists (news, posts) ─────────────────────────────────────── */
  .dated-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dated-list li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .dated-list li:last-child {
    border-bottom: 0;
  }

  .dated-list time {
    font-family: var(--font-mono);
    color: var(--global-text-color-light);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.22rem;
    white-space: nowrap;
  }

  .dated-body {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--global-text-color);
  }

  .news-body :global(p) {
    display: inline;
    margin: 0;
  }

  .news-body :global(p + p) {
    margin-left: 0.35rem;
  }

  .news-body :global(p + p a)::after {
    content: ' \2197';
    font-size: 0.8em;
  }

  .post-link {
    color: var(--global-text-color);
    font-weight: 500;
  }

  .post-link:hover {
    color: var(--global-theme-color);
  }

  @media (max-width: 540px) {
    .dated-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  /* ── Selected publications ─────────────────────────────────────────── */
  .paper-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .paper-item {
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--global-divider-color);
    border-radius: var(--ui-radius);
    background: var(--global-card-bg-color);
    box-shadow: var(--ui-shadow-sm);
    transition:
      border-color 0.15s ease,
      box-shadow 0.2s ease;
  }

  .paper-item:hover {
    border-color: color-mix(in srgb, var(--global-theme-color) 45%, var(--global-divider-color));
    box-shadow: var(--ui-shadow-hover);
  }

  .paper-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }

  .paper-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--global-text-color-light);
    font-variant-numeric: tabular-nums;
  }

  .badge-award {
    background-color: var(--global-award-bg);
    color: var(--global-award-text);
  }

  .paper-title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.08rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--global-text-color);
  }

  .paper-title:hover {
    color: var(--global-theme-color);
  }

  .paper-authors,
  .paper-venue {
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
    color: var(--global-text-color-light);
  }

  .paper-authors strong {
    color: var(--global-text-color);
    font-weight: 600;
  }

  .paper-venue {
    font-style: italic;
  }

  .paper-tldr {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--global-text-color);
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
  }

  .paper-links a {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    background: var(--global-bg-color);
    color: var(--global-text-color);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .paper-links a:hover {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
    background: var(--global-theme-tint);
  }

  /* ── Selected work ─────────────────────────────────────────────────── */
  .work-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.9rem;
  }

  .work-item {
    display: flex;
    flex-direction: column;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--global-divider-color);
    border-radius: var(--ui-radius);
    background: var(--global-card-bg-color);
    box-shadow: var(--ui-shadow-sm);
    transition:
      border-color 0.15s ease,
      box-shadow 0.2s ease;
  }

  .work-item:hover {
    border-color: color-mix(in srgb, var(--global-theme-color) 45%, var(--global-divider-color));
    box-shadow: var(--ui-shadow-hover);
  }

  .work-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.06rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--global-text-color);
  }

  .work-title:hover {
    color: var(--global-theme-color);
  }

  .work-desc {
    flex: 1;
    margin: 0.4rem 0 0.85rem;
    font-size: 0.885rem;
    line-height: 1.55;
    color: var(--global-text-color-light);
  }

  .work-repo {
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid var(--global-divider-color);
    font-size: 0.78rem;
    font-family: var(--font-mono, ui-monospace, monospace);
  }
</style>
